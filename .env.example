# ── Notion ─────────────────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=       # The database UUID
Voyage_API_KEY=           # For AI enrichment

# ── Telegram (Stage 06) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── FlareSolverr (Stages 01, 03, 04) ──────────────────────────────────
JAV_FLARESOLVERR_PORTS=8191,8192,8193
JAV_FLARESOLVERR_CONTAINER_PREFIX=flaresolverr   # Docker container name prefix
JAV_FLARESOLVERR_CLEAR_VOLUMES=false             # Set true to wipe browser profiles each run
JAV_FLARESOLVERR_TIMEOUT_MS=60000
JAV_FLARESOLVERR_COOLDOWN_MS=300000

# ── Stage 01: Ingest ──────────────────────────────────────────────────
JAV_INGEST_WORKERS=1
JAV_INGEST_ITEM_DELAY_MIN_MS=300
JAV_INGEST_ITEM_DELAY_MAX_MS=1000
JAV_INGEST_PAGE_DELAY_MIN_MS=2000
JAV_INGEST_PAGE_DELAY_MAX_MS=4000

# ── Stage 03: Verify URL ──────────────────────────────────────────────
# Optional override for Stage 3; defaults to JAV_FLARESOLVERR_PORTS / 8191,8192,8193
JAV_VERIFY_FLARESOLVERR_PORTS=8191,8192,8193
JAV_VERIFY_CONCURRENCY=4
JAV_VERIFY_FLARESOLVERR_TIMEOUT_MS=30000        # per-request timeout (warm sessions)
JAV_VERIFY_FLARESOLVERR_WARMUP_MS=120000        # first-request timeout (Cloudflare challenge)
JAV_VERIFY_FLARESOLVERR_COOLDOWN_MS=300000      # cooldown after N consecutive failures
JAV_VERIFY_FLARESOLVERR_DELAY_MS=200            # between-request throttle
JAV_VERIFY_FLARESOLVERR_FAIL_STREAK=3           # consecutive failures before cooldown

# ── Stage 04: Rankings ────────────────────────────────────────────────
# RANKINGS_TEST_FORCE_FAIL_PAGE=Monthly Star:3

# ── Stage 07: Delete / Cleanup ────────────────────────────────────────
JAV_CLEANUP_LOG_RETENTION_DAYS=30
JAV_CLEANUP_ARTIFACT_RETENTION_DAYS=7
JAV_CLEANUP_RUN_RETENTION_DAYS=90
JAV_CLEANUP_SUMMARY_RETENTION_DAYS=30
JAV_CLEANUP_TRASH_RETENTION_DAYS=7
