[Unit]
Description=Schedule JAV Manager at 05:00, 11:00, 17:00 and 23:00 HKT

[Timer]
OnCalendar=*-*-* 05:00:00 Asia/Hong_Kong
OnCalendar=*-*-* 11:00:00 Asia/Hong_Kong
OnCalendar=*-*-* 17:00:00 Asia/Hong_Kong
OnCalendar=*-*-* 23:00:00 Asia/Hong_Kong
Persistent=false
AccuracySec=1min
RandomizedDelaySec=0
Unit=jav-pipeline.service

[Install]
WantedBy=timers.target
