[Unit]
Description=JAV-owned FlareSolverr on loopback port %i
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
ExecCondition=/usr/bin/test %i -ge 8291
ExecCondition=/usr/bin/test %i -le 8293
ExecStart=/usr/bin/docker run --rm --name alfred-jav-flaresolverr-%i --pull never --label alfred.owner=jav-manager --label alfred.port=%i --label alfred.purpose=jav-active --publish 127.0.0.1:%i:8191/tcp --cpus=1.5 --memory=2g --memory-swap=2560m --pids-limit=512 --shm-size=512m "--health-cmd=/usr/bin/curl -fsS http://127.0.0.1:8191/ || exit 1" --health-interval=30s --health-timeout=5s --health-start-period=30s --health-retries=3 ghcr.io/flaresolverr/flaresolverr@sha256:139dfee1c6f89249c8d665d1333a42e8ec74ec0a86bc6bb1c8461e10d3a66a47
ExecStop=-/usr/bin/docker stop --time 30 alfred-jav-flaresolverr-%i
Restart=on-failure
RestartSec=10
TimeoutStartSec=3min
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target
