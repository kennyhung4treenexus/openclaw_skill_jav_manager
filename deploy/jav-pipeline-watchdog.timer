[Unit]
Description=Watch accepted-target JAV Manager scheduled completion

[Timer]
OnCalendar=*-*-* 05:30:00 Asia/Hong_Kong
OnCalendar=*-*-* 11:30:00 Asia/Hong_Kong
OnCalendar=*-*-* 17:30:00 Asia/Hong_Kong
OnCalendar=*-*-* 23:30:00 Asia/Hong_Kong
Persistent=false
AccuracySec=1min
RandomizedDelaySec=0
Unit=jav-pipeline-watchdog.service

[Install]
WantedBy=timers.target
