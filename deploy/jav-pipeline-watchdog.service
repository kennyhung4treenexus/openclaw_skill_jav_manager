[Unit]
Description=Check accepted-target JAV Manager scheduler health
After=jav-pipeline.service

[Service]
Type=oneshot
EnvironmentFile=/srv/alfred/shared/jav-manager/config/runtime.env
ExecStart=/srv/alfred/prod/jav-manager/current/deploy/jav-pipeline-watchdog.sh
TimeoutStartSec=3min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/alfred/shared/jav-manager
